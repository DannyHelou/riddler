# Leave the Supabase vars empty to use the local file store (.data/burner.json).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # server only
TYPESAFE_API_KEY=               # server only, word judge (Jev by TypeSafe AI); takes priority over Anthropic
ANTHROPIC_API_KEY=              # server only, fallback word judge (Claude Haiku 4.5)
LAUNCH_DATE=2026-10-04          # puzzle #1, America/Toronto

# Optional
JEV_MODEL=jev-1.13.0            # pinned Jev version; use jev-latest to follow new releases
NEXT_PUBLIC_SITE_DOMAIN=riddlerr.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Dev/testing only: pretend today is this date (America/Toronto), e.g. 2026-10-01.
PUZZLE_DATE_OVERRIDE=
# Dev only: reuse scheduled sets on days with no schedule entry (always on outside production).
BURNER_FALLBACK_SCHEDULE=
# Local file store location (default .data/burner.json)
BURNER_DATA_FILE=
