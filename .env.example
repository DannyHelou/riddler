# Leave the Supabase vars empty to use the local file store (.data/burner.json).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # server only
ANTHROPIC_API_KEY=              # server only, word judge (Claude Haiku 4.5)
VOYAGE_API_KEY=                 # server only, embeddings
LAUNCH_DATE=2026-10-01          # puzzle #1, America/Toronto

# Optional
NEXT_PUBLIC_SITE_DOMAIN=riddler.example
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Dev/testing only: pretend today is this date (America/Toronto), e.g. 2026-10-01.
PUZZLE_DATE_OVERRIDE=
# Dev only: reuse scheduled sets on days with no schedule entry (always on outside production).
BURNER_FALLBACK_SCHEDULE=
# Local file store location (default .data/burner.json)
BURNER_DATA_FILE=
